# Application settings
APP_NAME=Smart Load Protection Panel
APP_ENV=development

# MQTT broker settings
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=smart-panel-backend

# Database settings
# Copy this file to .env and change DATABASE_PASSWORD before first use.
# .env is ignored by Git. Never commit real credentials.
# When the backend later runs inside Docker, DATABASE_HOST becomes "db".
# On the Windows host use 127.0.0.1, not "localhost": Docker publishes the
# port on IPv4 only, while "localhost" resolves to IPv6 ::1 first and can
# stall for the full OS timeout before falling back to IPv4.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=smart_panel
DATABASE_USER=smart_panel_user
DATABASE_PASSWORD=change_me_before_use

# Authentication
# Generate a random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value.
JWT_SECRET=change_me_to_a_random_value_at_least_32_characters_long
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Dashboard origin(s) allowed by CORS, comma-separated.
CORS_ORIGINS=http://localhost:5173

# Simple in-process login limiter (single-process MVP only).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300